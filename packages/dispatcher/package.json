{
  "name": "@kanborg/dispatcher",
  "version": "0.1.0",
  "description": "Agent runtime \u2014 spawns and supervises CLI agents (claude, codex), parses stream-json",
  "license": "MIT",
  "author": "Leonardo Cunha",
  "homepage": "https://kanborg.ai",
  "bugs": "https://github.com/tvanroo/kanbots/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tvanroo/kanbots.git",
    "directory": "packages/dispatcher"
  },
  "keywords": [
    "kanbots",
    "agent",
    "claude-code",
    "codex-cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench:preview-proxy": "node --experimental-strip-types bench/preview-proxy.bench.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
